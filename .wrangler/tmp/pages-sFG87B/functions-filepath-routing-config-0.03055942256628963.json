{
  "routes": [
    {
      "routePath": "/api/ai-proxy",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/ai-proxy.js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/ai-proxy",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/ai-proxy.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/health",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/health.js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/rank-fetch",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/rank-fetch.js:onRequestGet"
      ]
    },
    {
      "routePath": "/v1/logs",
      "mountPath": "/v1",
      "method": "POST",
      "module": [
        "v1/logs.js:onRequestPost"
      ]
    }
  ],
